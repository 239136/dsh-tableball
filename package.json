{
  "name": "dsh-tableball",
  "version": "0.5.0",
  "description": "桌宠桌面台球：独立透明覆盖层",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs vendor/rack/web/tests/*.test.mjs",
    "test:lan": "node --test test/rack-*.test.cjs test/viewport.test.cjs test/lan-settings.test.cjs vendor/rack/web/tests/*.test.mjs",
    "test:lan:ui": "node scripts/rack-render-e2e.cjs && node scripts/rack-main-e2e.cjs && node scripts/rack-client-main-e2e.cjs",
    "start": "node scripts/menu.cjs",
    "play": "node scripts/launch.cjs",
    "build": "node scripts/build-tracker.cjs && node scripts/build-desktop.cjs && node scripts/build-visibility.cjs",
    "prepare:standalone": "node scripts/prepare-runtimes.cjs && node scripts/verify-runtime-cache.cjs && npm install --omit=dev --ignore-scripts --legacy-peer-deps --install-links && node scripts/prepare-owned-native.cjs",
    "pack:standalone": "node scripts/build-unified.cjs",
    "test:standalone": "node scripts/unified-smoke.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "runtime",
    "runtime/bin/*.exe",
    "native",
    "scripts/**/*.cjs",
    "scripts/**/*.ps1",
    "test/*.test.cjs",
    "vendor/rack",
    "cordis.patch.yml",
    "README.md",
    "LAN-GUIDE.md",
    "LAN-REUSE.md",
    "THIRD_PARTY_NOTICES.md",
    "lan-host-view.png",
    "lan-guest-view.png",
    "ball-material-preview.png",
    "vendor/dsh-pet",
    "vendor/dsh-pet-source",
    "vendor/edge-tts-source",
    "vendor/*-upstream.json",
    "vendor/pet-patches.json",
    "runtime-pins.json",
    "package-lock.json",
    "LICENSES.md",
    "PET-ASSET-NOTICES.md",
    "STANDALONE.md",
    "TableBall.cmd",
    "TableBall-settings.cmd",
    "TableBall-stop.cmd",
    "SBOM.json",
    "LICENSE-CODE-MIT.txt",
    "DEPENDENCY-INTEGRATION-AUDIT.md",
    "runtime-files.json"
  ],
  "dependencies": {
    "dsh-pet": "file:vendor/dsh-pet",
    "@andresaya/edge-tts": "1.9.1",
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "1.0.8",
    "@electron/get": "5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "bundleDependencies": [
    "dsh-pet",
    "@andresaya/edge-tts",
    "@anthropic-ai/sdk",
    "@electron-internal/extract-zip",
    "@electron/get",
    "openai",
    "zod"
  ],
  "license": "SEE LICENSE IN LICENSES.md",
  "engines": {
    "node": ">=22.12.0"
  }
}
